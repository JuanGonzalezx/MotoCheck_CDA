# Copiar como .env y ajustar. El archivo .env NO se sube al repositorio.

# Puerto del ESP32: COM6 / COM7 en Windows, /dev/cu.usbserial-XXXX o /dev/cu.SLAB_USBtoUART en Mac,
# /dev/ttyUSB0 en Linux. "simulado" usa el ESP32 virtual (sin hardware).
# Para ver los puertos disponibles: npm run puertos
SERIAL_PORT=simulado
SERIAL_BAUD=115200

# MongoDB Atlas: Database > Connect > Drivers > copiar la cadena. Vacío = guardar en archivos locales (carpeta datos/).
MONGODB_URI=
MONGODB_DB=motocheck

# Puerto del panel web: http://localhost:3000
PORT=3000

# Solo en modo simulado: 1 = tiempos reales (~35 s por moto), 3 = tres veces más rápido
SIM_VELOCIDAD=1
